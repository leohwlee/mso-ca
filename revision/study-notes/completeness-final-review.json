    {
      "id": "R1",
      "status": "resolved",
      "issue": "Section 75 actor was incorrectly narrowed to relevant authority.",
      "final_readback": "TC now uses 指明當局 and EN specified authority; section 75 branches and public-interest commencement retained.",
      "source": "04 section 75(1)-(2)"
    },
    {
      "id": "R2",
      "status": "resolved",
      "issue": "Assessment nominee list omitted sole proprietor.",
      "final_readback": "Both languages now include sole proprietor, partner or natural-person director with the seniority/accountability criteria.",
      "source": "01 paragraphs 4.1-4.2"
    },
    {
      "id": "R3",
      "status": "resolved",
      "issue": "DNFBP definition was located only to Schedule 2.",
      "final_readback": "Citation now includes Schedule 1 Part 1 section 1, retaining Schedule 2 section 1 for recognized digital identification.",
      "source": "04 Schedule 1 Part 1 section 1 and Schedule 2 section 1"
    },
    {
      "id": "R4",
      "status": "resolved",
      "issue": "Nationality declaration fallback lacked the cited source support.",
      "final_readback": "Fallback removed; obtain nationality versus general verification-set distinction remains, without waiving collection.",
      "source": "03 paragraphs 4.3.2-4.3.5 and 4.3.13"
    },
    {
      "id": "R5",
      "status": "resolved",
      "issue": "Common shell-bank affiliate controller was not explicitly an individual.",
      "final_readback": "Both languages now require an individual simultaneously controlling both corporations.",
      "source": "04 Schedule 2 section 17(3)(b)"
    },
    {
      "id": "R6",
      "status": "resolved",
      "issue": "No eligible nomination within seven days was framed as merely discretionary invalidation.",
      "final_readback": "Both prose and recall row now state invalidity and licence lapse at expiry for the applicable renewal condition.",
      "source": "05 paragraphs 6.2 and 6.4(c); conflict decision B27"
    },
    {
      "id": "T1",
      "status": "resolved",
      "issue": "TC FAQ payment roles differed from the official cited edition.",
      "final_readback": "Screening body uses 匯款人、收款人、匯款機構、中介機構、收款機構; originator-address heading/body use 匯款人.",
      "source": "06 AML/CFT FAQs A24-A26"
    },
    {
      "id": "T2",
      "status": "resolved",
      "issue": "Property term contained an extra character.",
      "final_readback": "TC now uses 據法權產; property and overseas-proceeds claims match the stored statutory definition.",
      "source": "04 Schedule 1 Part 1 section 1"
    }
  ],
